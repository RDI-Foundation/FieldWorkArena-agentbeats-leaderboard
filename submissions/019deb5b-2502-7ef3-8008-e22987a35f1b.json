{
  "manifest_version": "0.1.0",
  "config_schema": {
    "type": "object",
    "properties": {
      "agent_gemini_api_key": {
        "type": "string",
        "secret": true
      },
      "agent_llm_model": {
        "type": "string"
      },
      "agent_llm_provider": {
        "type": "string"
      },
      "agent_max_image_edge": {
        "type": "string"
      },
      "agent_openai_api_key": {
        "type": "string",
        "secret": true
      },
      "agent_openai_model": {
        "type": "string"
      },
      "agent_reasoning_effort": {
        "type": "string"
      },
      "agent_reasoning_effort_json": {
        "type": "string"
      },
      "agent_reasoning_effort_numeric": {
        "type": "string"
      },
      "green_hf_token": {
        "type": "string",
        "secret": true
      },
      "green_openai_api_key": {
        "type": "string",
        "secret": true
      }
    },
    "required": [
      "green_openai_api_key",
      "green_hf_token"
    ],
    "additionalProperties": false
  },
  "components": {
    "gateway": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/agentbeats-gateway/refs/tags/v0.1/amber-manifest.json5",
      "config": {
        "assessment_config": {
          "target": "all"
        },
        "participant_roles": {
          "green": "green",
          "purple1": "agent"
        },
        "callback_urls": {
          "green": "${bindings.green-proxy.url}"
        }
      }
    },
    "green": {
      "manifest": "https://raw.githubusercontent.com/RDI-Foundation/FieldWorkArena-agentbeats/refs/heads/main/amber/amber-manifest-green.json5",
      "config": {
        "hf_token": "${config.green_hf_token}",
        "openai_api_key": "${config.green_openai_api_key}"
      }
    },
    "agent": {
      "manifest": "https://raw.githubusercontent.com/ab-shetty/mids-fieldworkarena-alpha/refs/heads/main/amber-manifest.json5",
      "config": {
        "gemini_api_key": "${config.agent_gemini_api_key}",
        "llm_model": "${config.agent_llm_model}",
        "llm_provider": "${config.agent_llm_provider}",
        "max_image_edge": "${config.agent_max_image_edge}",
        "openai_api_key": "${config.agent_openai_api_key}",
        "openai_model": "${config.agent_openai_model}",
        "reasoning_effort": "${config.agent_reasoning_effort}",
        "reasoning_effort_json": "${config.agent_reasoning_effort_json}",
        "reasoning_effort_numeric": "${config.agent_reasoning_effort_numeric}"
      }
    }
  },
  "bindings": [
    {
      "to": "#gateway.green",
      "from": "#green.a2a"
    },
    {
      "to": "#gateway.purple1",
      "from": "#agent.a2a"
    },
    {
      "to": "#green.proxy",
      "from": "#gateway.proxy",
      "weak": true,
      "name": "green-proxy"
    }
  ],
  "exports": {
    "results": "#gateway.results"
  },
  "metadata": {
    "agentbeats_ids": {
      "green": "019cfcce-a316-7fe0-8b7f-fbfc4706534a",
      "agent": "019deb58-0a62-7db1-b453-192d88c39ab0"
    }
  }
}